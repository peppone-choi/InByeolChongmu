# Copy once to .env.local. Never overwrite a file containing your keys.
NODE_ENV=development
APP_DEPLOYMENT=local
PORT=3000
DATABASE_PATH=.local/inbyeol.sqlite
FLUE_DATABASE_PATH=.local/flue.sqlite
SELLER_ID=sample-seller-01
# Optional locally; Docker requires a random token of at least 32 characters.
LOCAL_API_TOKEN=
# Set flue to enable live model calls on /api/chat. disabled keeps data tools usable.
AGENT_BACKEND=disabled
AGENT_MODEL=openai/gpt-5.5
AGENT_CONVERSATION_ID=
AGENT_TIMEOUT_MS=60000
AGENT_MAX_MODEL_CALLS=8
AGENT_MAX_TOOL_CALLS=16
AGENT_MAX_OUTPUT_TOKENS=4096
AGENT_HISTORY_MESSAGES=40
AGENT_HISTORY_CHARACTERS=40000
OPENAI_API_KEY=
# Optional. Adds the real classify_inquiry tool when configured.
TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Reserved for a future gateway route. The current Flue path calls OpenAI directly.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_API_TOKEN=
AI_GATEWAY_API_KEY=
