# Copy to .env.local. No provider is contacted by this backend yet.
NODE_ENV=development
PORT=3000
DATABASE_PATH=.local/inbyeol.sqlite
SELLER_ID=sample-seller-01
# Optional bearer protection for local API. Public hosting is not supported yet.
LOCAL_API_TOKEN=
# Deferred runtime integrations; filling keys does not enable model calls yet.
AGENT_BACKEND=disabled
AGENT_CONVERSATION_ID=
AGENT_MODEL=
OPENAI_API_KEY=
TYPESAFE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_API_TOKEN=
AI_GATEWAY_API_KEY=
